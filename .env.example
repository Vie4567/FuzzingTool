# DeepSeek API Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model Configurations
LLM_MODEL=DeepSeek-V4.1-Flash
LLM_TEMPERATURE=0.1

# Full sanitized LLM responses, one JSON object per line (no prompts/headers)
LLM_RESPONSE_LOG_FILE=logs/llm_responses.jsonl

# Fallback: OpenAI API Key
OPENAI_API_KEY=

# Manual HTTP proxy profiles for proxy_http (proxy_source=manual, the default).
# Use scripts/configure_proxy_profiles.py; do not commit proxy credentials.
FUZZ_PROXY_PROFILES=

# Automatic discovery is selected explicitly via CLI, not enabled by this file:
# python scripts/run_proxy_http_check.py --proxy-source proxyscrape --target https://cab.vn --proxy-count 3
# Optional CLI controls: --proxy-candidate-limit 20 --proxy-check-timeout 5
# --proxy-fetch-timeout 10 --proxy-refresh-seconds 300 --max-requests 23
# Manual credentials above are not loaded by the ProxyScrape runner mode.
# Configuration and shared budgets: docs/proxy_http_authorized_testing.md
