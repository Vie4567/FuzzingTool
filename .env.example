# ── Sentinel Pentest — Environment Variables Example ──────────────
# Copy sang .env và điền giá trị thật (KHÔNG commit .env vào git)

# ── Neo4j ──────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ── LLM ────────────────────────────────────────────────────────────
# Dùng OpenAI:
#   OPENAI_API_KEY=sk-...
#   (để trống OPENAI_BASE_URL)

# Dùng DeepSeek (OpenAI-compatible):
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.deepseek.com

# ── Pipeline config (optional) ─────────────────────────────────────
# LLM_MODEL=deepseek-chat        # hoặc gpt-4o khi dùng OpenAI
# LLM_TEMPERATURE=0.1
# KNOWLEDGE_STORE_DIR=knowledge_store
